{
  "schemaVersion": 1,
  "id": "basemaps",
  "version": "${version}",
  "name": "Basemaps",
  "description": "Overlay your own images (PNG/JPG) on Xaero's World Map at world coordinates, under or over the explored map. Images live in the 'basemaps' folder of the game directory. No network access.",
  "authors": [
    "Wraith_k25"
  ],
  "contact": { "sources": "https://github.com/fpvwraith/Basemaps", "issues": "https://github.com/fpvwraith/Basemaps/issues" },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "tools.argus.basemaps.BasemapsMod"
    ]
  },
  "mixins": [
    "basemaps.mixins.json"
  ],
  "depends": {
    "java": ">=21",
    "fabricloader": ">=0.18.2",
    "minecraft": "~${minecraft_version}",
    "fabric-api": "*",
    "xaeroworldmap": ">=1.45.0"
  },
  "suggests": {
    "xaeroplus": "*"
  }
}
